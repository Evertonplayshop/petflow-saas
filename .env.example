# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted (for example https://your-app.vercel.app).
APP_URL="MY_APP_URL"

# SUPABASE (Client - Safe public keys only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SUPABASE (Server-only - NEVER prefix with VITE_ or expose in browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cakto monthly billing
CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/36edgkj_1356460
CAKTO_WEBHOOK_SECRET=
CAKTO_MONTHLY_PRICE_CENTS=5000
